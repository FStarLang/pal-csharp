+module ReturnPostCompression
+
+#lang-pulse
+open Pulse.Lib.Pervasives
+module B = Pulse.Lib.Box
+
+noeq type evidence (a: Type0) = { equal: a -> a -> bool }
+noeq type owner (a: Type0) {| d: evidence a |} = { value: a }
+
+// The dictionary is solved during elaboration, but a unification node may
+// remain in the stack-local cleanup post. It is not a free-variable clash.
+fn explicit_hole (a: Type0) {| d: evidence a |}
+  requires emp
+  ensures emp
+{
+  let mut cell: B.box (owner a #_) = B.null;
+  ()
+}
+
+fn implicit_dictionary (a: Type0) {| d: evidence a |}
+  requires emp
+  ensures emp
+{
+  let mut cell: B.box (owner a) = B.null;
+  ()
+}
+
+fn named_dictionary (a: Type0) {| d: evidence a |}
+  requires emp
+  ensures emp
+{
+  let mut cell: B.box (owner a #d) = B.null;
+  ()
+}
