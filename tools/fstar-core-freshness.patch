+module CoreFreshness.Support
+#lang-pulse
+open Pulse
+module Seq = FStar.Seq
+module I32 = FStar.Int32
+
+// A dependent implementation dictionary, with no external runtime assumptions.
+noeq type descriptor (m:Type0)
+  (api:(i:Type0) -> (i -> perm -> m -> slprop) -> Type0) = {
+  impl:Type0;
+  owns:impl -> perm -> m -> slprop;
+  value:impl;
+  base:option (api impl owns);
+}
+let supports (#m:Type0) (#api:(i:Type0) -> (i -> perm -> m -> slprop) -> Type0)
+  (w:descriptor m api) = Some? w.base
+let reader (m r:Type0)
+  (api:(i:Type0) -> (i -> perm -> m -> slprop) -> Type0)
+  (post:m -> r -> prop) =
+  i:Type0 -> owns:(i -> perm -> m -> slprop) -> api i owns ->
+    x:i -> #p:perm -> #model:erased m ->
+      stt r (owns x p model)
+        (fun result -> owns x p model ** pure (post model result))
+
+noeq type model (t r:Type0) = { items:Seq.seq t; scalar:r }
+val slots (t r i:Type0) (owns:i -> perm -> model t r -> slprop) : Type0
+let contents (#t #r:Type0) (m:model t r) = m.items
+let scalar (#t #r:Type0) (m:model t r) = m.scalar
+val select_length (#t #r:Type0) :
+  reader (model t r) I32.t (slots t r)
+    (fun m n -> I32.v n == Seq.length (contents m))
+val select_scalar (#t #r:Type0) :
+  reader (model t r) r (slots t r) (fun m n -> n == scalar m)
+
+val pts_to (#t #m:Type0)
+  (#api:(i:Type0) -> (i -> perm -> m -> slprop) -> Type0)
+  (contents:m -> Seq.seq t) (flag:bool)
+  (w:erased (descriptor m api)) (p:perm) (state:erased m) : slprop
+
+fn matches (#t #m:Type0)
+  (#api:(i:Type0) -> (i -> perm -> m -> slprop) -> Type0)
+  (contents:m -> Seq.seq t) (flag:bool)
+  (#w:erased (descriptor m api)) (#p:perm) (#state:erased m)
+  preserves pts_to contents flag w p state
+  returns result:bool
+  ensures pure (result == supports w)
