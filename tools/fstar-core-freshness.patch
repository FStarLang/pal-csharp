+module CoreFreshness.Support
+#lang-pulse
+open Pulse
+module Seq = FStar.Seq
+module I32 = FStar.Int32
+
+#set-options "--z3rlimit 10"
+
+noeq type slots (t r i:Type0) (owns:i -> perm -> model t r -> slprop) = {
+  length:x:i -> #p:perm -> #m:erased (model t r) ->
+    stt I32.t (owns x p m)
+      (fun result -> owns x p m **
+        pure (I32.v result == Seq.length (reveal m).items));
+  observation:x:i -> #p:perm -> #m:erased (model t r) ->
+    stt r (owns x p m)
+      (fun result -> owns x p m ** pure (result == (reveal m).scalar));
+}
+let select_length (#t #r:Type0) (i:Type0)
+  (owns:i -> perm -> model t r -> slprop) (s:slots t r i owns) = s.length
+let select_scalar (#t #r:Type0) (i:Type0)
+  (owns:i -> perm -> model t r -> slprop) (s:slots t r i owns) = s.observation
+
+let pts_to (#t #m:Type0)
+  (#api:(i:Type0) -> (i -> perm -> m -> slprop) -> Type0)
+  (contents:m -> Seq.seq t) (flag:bool)
+  (w:erased (descriptor m api)) (p:perm) (state:erased m) : slprop =
+  (reveal w).owns (reveal w).value p state ** pure (flag == supports w)
+
+fn matches (#t #m:Type0)
+  (#api:(i:Type0) -> (i -> perm -> m -> slprop) -> Type0)
+  (contents:m -> Seq.seq t) (flag:bool)
+  (#w:erased (descriptor m api)) (#p:perm) (#state:erased m)
+  preserves pts_to contents flag w p state
+  returns result:bool
+  ensures pure (result == supports w)
+{
+  unfold (pts_to contents flag w p state);
+  fold (pts_to contents flag w p state);
+  flag
+}
