<!--
  A stand-in for a vendor SDK, for test/external_library (R21.5a): a library that is built
  on its own and that a verified program reaches only as metadata, through `palcs -r`.
  The leading underscore keeps it out of test/Makefile's list of acceptance directories.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>AcmeSdk</AssemblyName>
  </PropertyGroup>
</Project>
