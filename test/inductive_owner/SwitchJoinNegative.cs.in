using PalLang;

public static class SwitchJoinNegative
{
    public static int FalseJoin(int selector, bool choose)
    {
        int result = 0;
        switch (selector)
        {
            case 0:
                if (choose) { result = 1; }
                else { result = 2; }
                Pal.Join(result == 3);
                break;
            default:
                result = 4;
                break;
        }
        return result;
    }

    public static void Stray(int selector)
    {
        switch (selector)
        {
            default:
                Pal.Join(true);
                break;
        }
    }
}
