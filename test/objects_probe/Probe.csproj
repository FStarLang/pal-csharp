<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compile-only. The point is to prove that the annotated C# in this
       directory is valid C#; the proof obligations live in the .fst files. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Pal.Probe.Objects</AssemblyName>
    <RootNamespace>PalCSharp.Probe</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Pal.Annotations/Pal.Annotations.csproj" />
  </ItemGroup>

</Project>
