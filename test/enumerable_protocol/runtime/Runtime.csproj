<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ProtocolSource Condition="'$(ProtocolSource)' == ''">../Protocol.cs</ProtocolSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ProtocolSource)" />
    <Compile Include="../Runtime.cs" />
    <ProjectReference Include="../../../src/Pal.Annotations/Pal.Annotations.csproj" />
  </ItemGroup>
</Project>
