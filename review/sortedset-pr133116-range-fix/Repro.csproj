<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0436;SYSLIB0050;SYSLIB0051</NoWarn>
    <NuGetAudit>false</NuGetAudit>
    <UpstreamRoot Condition="'$(UpstreamRoot)' == ''">$(MSBuildProjectDirectory)/upstream</UpstreamRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(UpstreamRoot)/src/libraries/System.Collections/src/System/Collections/Generic/*.cs" />
    <Compile Include="$(UpstreamRoot)/src/libraries/Common/src/System/Collections/Generic/*.cs" />
    <Compile Include="Compatibility.cs" />
    <Compile Include="Regression.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
