@page
@model CartModel
@{ ViewData["Title"] = "Cart"; }
<h1>Your cart</h1>
@if (Model.Lines.Count == 0)
{
    <p>Your cart is empty. <a asp-page="/Index">Go shopping</a>.</p>
}
else
{
    <table>
        <tr><th>Pet</th><th>Price</th><th>In stock</th><th>Quantity</th><th>Subtotal</th></tr>
        @foreach (var l in Model.Lines)
        {
            <tr>
                <td>@l.Product.Name</td>
                <td>@Money.Format(l.Product.PriceCents)</td>
                <td class="@(l.Qty > l.Product.Stock ? "bad" : "")">@l.Product.Stock</td>
                <td>
                    <form method="post" asp-page-handler="Set">
                        <input type="hidden" name="product" value="@l.Product.Id" />
                        <input type="number" name="qty" value="@l.Qty" min="0" max="99" />
                        <button type="submit" class="secondary">Update</button>
                    </form>
                </td>
                <td>@Money.Format(l.Qty * l.Product.PriceCents)</td>
            </tr>
        }
        <tr><th colspan="4">Total</th><th>@Money.Format(Model.Lines.Sum(l => l.Qty * l.Product.PriceCents))</th></tr>
    </table>
    <form method="post" asp-page-handler="Checkout" style="margin-top:1rem">
        <button type="submit">Place order (no payment needed — it's a demo)</button>
    </form>
}
