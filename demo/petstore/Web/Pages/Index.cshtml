@page
@model IndexModel
@{ ViewData["Title"] = "Shop"; }
<h1>Pets</h1>
<div class="grid">
@foreach (var p in Model.Products)
{
    <div class="card">
        <h3>@p.Name</h3>
        <p class="muted">@p.Blurb</p>
        <p class="price">@Money.Format(p.PriceCents)</p>
        <p>@if (p.Stock > 0) { <span>@p.Stock in stock</span> } else { <span class="out">Sold out</span> }</p>
        <form method="post" asp-page-handler="Add">
            <input type="hidden" name="product" value="@p.Id" />
            <input type="number" name="qty" value="1" min="1" max="99" />
            <button type="submit">Add to cart</button>
        </form>
    </div>
}
</div>
